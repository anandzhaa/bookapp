CREATE TABLE IF NOT EXISTS BookEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    page_count INTEGER NOT NULL,
    excerpt TEXT NOT NULL,
    publish_date TEXT NOT NULL,
    created_at INTEGER NOT NULL DEFAULT 0
);

-- Queries
getAllBooks:
SELECT * FROM BookEntity ORDER BY id DESC;

getBookById:
SELECT * FROM BookEntity WHERE id = ?;

insertBook:
INSERT OR REPLACE INTO BookEntity(id, title, description, page_count, excerpt, publish_date, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteBook:
DELETE FROM BookEntity WHERE id = ?;

deleteAllBooks:
DELETE FROM BookEntity;

countBooks:
SELECT COUNT(*) FROM BookEntity;
